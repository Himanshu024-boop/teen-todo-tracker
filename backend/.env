PORT=5000
NODE_ENV=development

# Supabase Configuration
# Set your real Supabase project URL and service-role / anon key here
# When these are empty or left as placeholders, the server runs in development mode with local demo store.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret Configuration
JWT_SECRET=super-secret-teen-money-tracker-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# CORS Allowed Client
CLIENT_URL=http://localhost:5173
